#!/bin/sh
#
# Copyright (c) OpenIPC  https://openipc.org  MIT License
#
# wifi-button-watch -- optional physical setup button.
#
# Holding the button for WIFI_BUTTON_HOLD seconds erases the Wi-Fi settings
# and starts setup mode. Scoped deliberately narrowly: it does not touch
# majestic's configuration, the U-Boot environment, credentials for other
# services, or anything else a "factory reset" might be expected to clear.
# See docs/06-user-guide.md.
#
# Does nothing unless WIFI_BUTTON_GPIO names a pin, because there is no
# board-independent way to know which pin -- if any -- is a button rather
# than an IR-cut driver or a sensor reset.

LIB=/usr/libexec/wifi
. "$LIB/wifi-lib.sh"

[ -n "$WIFI_BUTTON_GPIO" ] || exit 0
command -v gpio >/dev/null 2>&1 || {
	wifi_warn "button watcher: the 'gpio' tool is missing"
	exit 0
}

# 1 while the button is physically pressed.
pressed() {
	_v=$(gpio read "$WIFI_BUTTON_GPIO" 2>/dev/null | tr -cd '01')
	[ -n "$_v" ] || return 1
	if [ "$WIFI_BUTTON_ACTIVE_LOW" = "1" ]; then
		[ "$_v" = "0" ]
	else
		[ "$_v" = "1" ]
	fi
}

wifi_log "button watcher active on GPIO $WIFI_BUTTON_GPIO (hold ${WIFI_BUTTON_HOLD}s)"

while :; do
	if pressed; then
		_held=0
		while pressed && [ "$_held" -lt "$WIFI_BUTTON_HOLD" ]; do
			sleep 1
			_held=$((_held + 1))
		done
		if [ "$_held" -ge "$WIFI_BUTTON_HOLD" ]; then
			wifi_log "setup button held for ${_held}s: erasing Wi-Fi settings"
			wifi_cmd_post forget
			# Wait for release so one long press is not read as several.
			while pressed; do sleep 1; done
		fi
	fi
	sleep 1
done
